# Mirrors .gitignore's "never publish" sections. Docker's build context is
# not filtered by .gitignore - without this file, `docker build .` (which
# DEPLOY.md 5.4 explicitly tells the operator to run locally before trusting
# the Dockerfile) would copy .env, the 702MB personal-data database, and any
# live browser/WhatsApp session straight into the image via `COPY . .`.

# Live credentials
backend/.browser-profile/
backend/.browser-profile-active/
.browser-profile/
bots/whatsapp/.auth/
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Personal data
data/
*.sqlite3
*.sqlite3-journal
*.db

# Never needed inside the image / would break the npm ci layers
.git/
node_modules/
backend/node_modules/
bots/telegram/node_modules/
bots/whatsapp/node_modules/
dist/
.vite/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local run artefacts
*.log
debug.log
inspect_output.txt
backend/test-artifacts/
*.zip
