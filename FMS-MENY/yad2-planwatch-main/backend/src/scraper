import { chromium } from 'playwright';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import fs from 'node:fs';

// Yad2 sits behind Radware bot protection (stormcasterv2.js). A fresh
// headless context always gets the "Radware Page" challenge and never
// passes it. Solution: use a PERSISTENT browser profile. Run `npm run
// login` once to open a visible browser and pass the challenge manually;
// the profile keeps the valid cookies/tokens. Then the scraper reuses
// that profile, navigates to the page, extracts the Next.js buildId, and
// performs a direct fetch() to the _next/data JSON endpoint from inside
// the browser (so all Radware cookies/headers are attached automatically).

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const PROFILE_DIR = path.join(__dirname, '..', '.browser-profile');

function ensureProfileDir() {
  if (!fs.existsSync(PROFILE_DIR)) fs.mkdirSync(PROFILE_DIR, { recursive: true });
}

export async function getPersistentContext(headless = true) {
  ensureProfileDir();
  return chromium.launchPersistentContext(PROFILE_DIR, {
    headless,
    channel: 'chrome',
    userAgent:
      'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36',
    locale: 'he-IL',
    viewport: { width: 1366, height: 768 },
    args: ['--disable-blink-features=AutomationControlled'],
  });
}

/**
 * Navigate to a yad2 page using the persistent profile and wait until the
 * real content loads (Radware challenge passed). Returns the page.
 */
async function navigateToRealPage(page, url) {
  await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 30000 });

  // Wait for the real page (title != "Radware Page") to appear.
  try {
    await page.waitForFunction(
      () => document.title !== 'Radware Page' && document.title !== '',
      { timeout: 20000 }
    );
  } catch {
    const title = await page.title();
    if (title === 'Radware Page' || title === '') {
      throw new Error(
        'Blocked by Radware bot protection. Run `npm run login` in the backend folder to open the browser and pass the one-time check, then try again.'
      );
    }
  }
  return page;
}

/**
 * Extract the Next.js buildId from the page. yad2 embeds it in a
 * <script id="__NEXT_DATA__"> JSON blob, and also in the DOM as
 * data attributes / script srcs. We try several strategies.
 */
async function extractBuildId(page) {
  return await page.evaluate(() => {
    // 1) __NEXT_DATA__ script tag
    const nd = document.getElementById('__NEXT_DATA__');
    if (nd) {
      try {
        const json = JSON.parse(nd.textContent);
        if (json.buildId) return json.buildId;
      } catch {}
    }
    // 2) Look for any _next/data/<id>/ URL in the DOM/scripts
    const scripts = Array.from(document.querySelectorAll('script[src]'));
    for (const s of scripts) {
      const m = s.src.match(/\/_next\/data\/([^/]+)\//);
      if (m) return m[1];
    }
    // 3) Search the raw HTML for the buildId pattern
    const html = document.documentElement.outerHTML;
    const m = html.match(/\/_next\/data\/([^/"]+)\//);
    if (m) return m[1];
    return null;
  });
}

/**
 * Build the _next/data JSON URL for a given search.
 * Pattern: /realestate/_next/data/{buildId}/{dealType}/{regionSlug}.json?...
 */
function buildDataUrl(buildId, filters) {
  const { dealType = 'forsale', regionSlug, area, city, page } = filters;
  const params = new URLSearchParams();
  params.set('slug', regionSlug);
  if (area) params.set('area', String(area));
  if (city) params.set('city', String(city));
  if (page && page > 1) params.set('page', String(page));
  return `https://www.yad2.co.il/realestate/_next/data/${buildId}/${dealType}/${regionSlug}.json?${params.toString()}`;
}

/**
 * Loads a yad2 real-estate search URL and returns the parsed _next/data
 * JSON payload. Uses the persistent profile so Radware's challenge is
 * already cleared, then fetches the data endpoint directly from inside
 * the browser context.
 *
 * @param {string} pageUrl - full yad2 search URL (the human-facing page)
 * @param {object} filters - filters used to build the data URL
 */
export async function fetchListingsPage(pageUrl, filters) {
  const context = await getPersistentContext(true);
  const page = await context.newPage();

  try {
    await navigateToRealPage(page, pageUrl);

    const buildId = await extractBuildId(page);
    if (!buildId) {
      throw new Error('Could not extract Next.js buildId from the page.');
    }

    const dataUrl = buildDataUrl(buildId, filters);

    // Perform the fetch from inside the browser so all cookies/headers
    // (uzmx, __uzm*, uzlc generated by stormcasterv2.js) are attached.
    const json = await page.evaluate(async (url) => {
      const res = await fetch(url, {
        headers: {
          accept: '*/*',
          'x-nextjs-data': '1',
        },
        credentials: 'include',
      });
      if (!res.ok) throw new Error(`Data fetch failed: ${res.status}`);
      return res.json();
    }, dataUrl);

    return json;
  } finally {
    await page.close().catch(() => {});
    await context.close();
  }
}

export async function closeBrowser() {
  // Persistent context is closed after each fetch; nothing to keep.
}