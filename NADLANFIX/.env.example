# Optional environment overrides
# PLANWATCH_DB=./data/planwatch.sqlite3
# PLANWATCH_LISTING_FEED_SECRET=your_feed_secret_here
# PLANWATCH_GOVMAP_KEY=your_govmap_key_here
# PLANWATCH_TABU_KEY=your_tabu_key_here
# PLANWATCH_TABU_URL=https://your-tabu-api.example.com
# PLANWATCH_PRIVATE_API_TOKEN=your_private_api_token_here
# PLANWATCH_PRIVATE_REVEAL_TOKEN=your_private_reveal_token_here
# PYTHON_API_BASE=http://127.0.0.1:8000

# Telegram/WhatsApp bots (bots/telegram, bots/whatsapp) - see DEPLOY.md.
# Both are optional; each exits quietly if unconfigured, same as the Node
# scraper does when it cannot start.
# PLANWATCH_TELEGRAM_TOKEN=your_botfather_token_here
# WHATSAPP_AUTH_DIR=./data/whatsapp-auth
# WHATSAPP_QR_PATH=./data/whatsapp-auth/qr.png

# Facebook Marketplace scraper
# PLANWATCH_FB_STORAGE_STATE=./data/facebook_storage_state.json
# PLANWATCH_FB_QUERY=מכירות בתים
# PLANWATCH_FB_MIN_PRICE=400000
# PLANWATCH_FB_TARGET=500
